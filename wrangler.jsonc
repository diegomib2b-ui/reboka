{
  // Hospedagem no Cloudflare Workers. O nome precisa ser igual ao do Worker no painel do Cloudflare.
  "name": "reboka",
  "compatibility_date": "2026-11-16",
  // Código que roda no servidor. Só é chamado nas rotas /api/*; o resto é o site estático em ./dist.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Valores públicos. Os segredos (MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET, SUPABASE_SECRET_KEY) ficam no painel do Cloudflare.
  "vars": {
    "SUPABASE_URL": "https://nsghugwgocrlyoekpgnj.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_hF4XxU7LV5GXI_TunS9mTg_p_fOtTzC"
  },
  // Mantém no deploy os segredos cadastrados pelo painel.
  "keep_vars": true
}
