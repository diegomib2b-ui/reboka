---
import Base from '../layouts/Base.astro';
import { planos, brl, TESTE_GRATIS_DIAS, DESCONTO_ANUAL } from '../data/site';

const passos = [
  { titulo: 'Abra o chamado', texto: 'Cliente, veículo, onde está e para onde vai. Com a distância, a cotação sai na hora pela sua tabela: saída, km, noturno e adicionais.' },
  { titulo: 'Despache e avise', texto: 'Escolha o motorista e toque em despachar. O WhatsApp abre com a mensagem pronta avisando o cliente que o guincho saiu.' },
  { titulo: 'Entregue e receba', texto: 'Na entrega, gere o Pix na tela ou marque que fica a receber da oficina ou da seguradora. O valor já entra no financeiro.' },
];

const recursos = [
  { titulo: 'Cotação por km', texto: 'Sua tabela de preço em um lugar só: saída, valor por km, km incluídos, acréscimo noturno e adicionais como patins. O total aparece enquanto você digita.', largo: true },
  { titulo: 'Link para o cliente pedir', texto: 'Cada guincho tem o seu link. O cliente abre no celular, envia a localização e o pedido cai direto nos seus chamados novos.' },
  { titulo: 'Quadro de chamados', texto: 'Novos, a caminho, carregados e entregues. Você bate o olho e sabe onde está cada veículo.' },
  { titulo: 'WhatsApp com mensagem pronta', texto: 'Cotação, guincho a caminho e entrega: um toque abre a conversa com o texto preenchido.' },
  { titulo: 'Pix na entrega', texto: 'QR Code e copia e cola com o valor do chamado, gerados com a sua chave. O dinheiro cai direto na sua conta, sem taxa de intermediário.', largo: true },
  { titulo: 'A receber por empresa', texto: 'Oficina, seguradora ou frota que paga depois fica marcada no chamado, com o total em aberto no topo da tela.' },
  { titulo: 'Motoristas e comissão', texto: 'Cada chamado com o motorista que atendeu. No fim do mês, o faturamento e a comissão de cada um já estão somados.' },
  { titulo: 'Clientes e parceiros', texto: 'Quem já chamou fica guardado com veículo, placa e histórico. Na próxima vez, o chamado abre mais rápido.', largo: true },
  { titulo: 'Remoção agendada', texto: 'Transporte marcado para amanhã ou para a semana que vem fica separado, com data e hora, até virar chamado.', largo: true },
];

const faq = [
  { p: 'Trabalho sozinho, com um caminhão. Serve para mim?', r: 'Serve, e foi pensado para isso. Você abre o chamado pelo celular em menos de um minuto e não precisa mais fazer conta de cabeça no meio do trânsito. O plano Essencial é para um usuário.' },
  { p: 'O cliente consegue pedir o guincho sozinho?', r: 'Sim. Você liga o seu link de pedidos e divulga no WhatsApp, no Google ou em um QR Code no caminhão. O cliente informa onde está, pode enviar a localização do celular, e o pedido aparece nos seus chamados novos. Você responde com o valor antes de sair.' },
  { p: 'Como o Reboka sabe a distância?', r: 'Você informa os quilômetros. Com origem e destino preenchidos, um link abre a rota no Google Maps para você conferir a distância. O Reboka faz o resto da conta pela sua tabela de preço.' },
  { p: 'Posso mudar o valor que o sistema calculou?', r: 'Pode. A cotação é uma sugestão pela sua tabela. Você edita o valor final antes de abrir o chamado, por exemplo para dar um desconto ou cobrar uma dificuldade extra.' },
  { p: 'Atendo oficina e seguradora que pagam depois. Como fica?', r: 'No chamado você informa quem paga. Na entrega, marca que fica a receber. O total em aberto aparece no topo da tela de chamados até você marcar como recebido.' },
  { p: 'Preciso contratar API do WhatsApp?', r: 'Não. O Reboka abre o WhatsApp que você já usa, no celular ou no computador, com a mensagem pronta. Quem envia é você, então não há custo extra.' },
  { p: 'O Reboka emite nota fiscal ou rastreia o caminhão?', r: 'Não. Ele cuida do chamado, da cotação, do despacho e da cobrança. Nota fiscal e rastreador por GPS continuam onde você já controla.' },
  { p: 'Como funciona o teste grátis?', r: `São ${TESTE_GRATIS_DIAS} dias com todos os recursos, sem cartão de crédito. No fim do período você escolhe um plano ou a conta fica pausada, sem cobrança.` },
  { p: 'Posso cancelar quando quiser?', r: 'Pode. O plano mensal não tem fidelidade e o cancelamento é feito no próprio painel.' },
  { p: 'Os dados dos meus clientes ficam seguros?', r: 'Cada empresa tem os dados isolados das demais, o acesso é por login individual e seguimos a LGPD. Você pode exportar ou apagar tudo quando quiser.' },
  { p: 'Funciona no celular?', r: 'Sim. O painel abre no navegador do celular, do tablet e do computador, e pode ser instalado na tela inicial como um aplicativo.' },
];
---
<Base titulo="Reboka | Sistema de gestão para guincho e reboque">

  <section class="hero">
    <div class="container hero-grade">
      <div class="hero-texto">
        <p class="hero-olho">Sistema de gestão para guincho e reboque</p>
        <h1>O sistema que organiza o seu guincho,<br /><span class="hl2 realce">do chamado ao Pix</span></h1>
        <p class="lead">Você assina, abre no celular e controla tudo em uma tela: chamados, cotação por km, motoristas e cobrança. Sem instalar nada.</p>
        <div class="hero-acoes">
          <a class="btn btn-primario" href="/cadastro/">Testar {TESTE_GRATIS_DIAS} dias grátis</a>
          <a class="btn btn-secundario" href="/app/?demo=1">Ver a demonstração</a>
        </div>
        <ul class="hero-fatos">
          <li>Funciona no celular</li>
          <li>Assinatura a partir de {brl(planos[0].precoMensal)} por mês</li>
          <li>{TESTE_GRATIS_DIAS} dias grátis, sem cartão</li>
        </ul>
      </div>

    </div>

    <figure class="hero-foto">
      <img src="/img/hero-guincho.webp" width="1600" height="1067" fetchpriority="high" alt="Caminhão guincho plataforma laranja levando um carro antigo por uma avenida" />
    </figure>
  </section>

  <div class="emenda" aria-hidden="true"></div>

  <section class="secao oque" id="o-que-e">
    <div class="container">
      <h2>O que é o Reboka</h2>
      <p class="lead">É um sistema online, por assinatura mensal, feito para quem trabalha com guincho. Você usa no navegador do celular ou do computador para registrar cada chamado, calcular o preço, despachar o motorista e cobrar.</p>

      <ul class="oque-lista">
        <li><b>1. Registra o chamado</b>Você digita, ou o cliente pede pelo seu link com a localização.</li>
        <li><b>2. Calcula o preço</b>Saída + km + noturno + adicionais, pela sua tabela.</li>
        <li><b>3. Despacha e avisa</b>Motorista definido e mensagem pronta no WhatsApp.</li>
        <li><b>4. Cobra e controla</b>Pix na entrega e o que ficou a receber.</li>
      </ul>

      <p class="oque-nao"><b>O Reboka não distribui chamados entre guincheiros.</b> O cliente chama você pelo telefone, pelo WhatsApp ou pelo seu link de pedidos, e o pedido chega só para você. O Reboka organiza tudo o que acontece depois.</p>

      <h3 class="oque-sub">O guincho roda na rua. A gestão ainda roda no caderno.</h3>

      <div class="trio">
        <div><h3>A cotação</h3><p>sai de cabeça, <b>no meio do trânsito</b>.</p></div>
        <div><h3>A cobrança</h3><p>fica <b>na memória</b> e em conversa antiga.</p></div>
        <div class="trio-destaque"><h3>O Reboka</h3><p>cota, despacha e cobra <b>no mesmo lugar</b>.</p></div>
      </div>

      <div class="publicos">
        <article class="publico">
          <h3>Para quem roda sozinho</h3>
          <p class="quem-e">Guincheiro autônomo, com um caminhão, que atende o telefone e dirige.</p>
          <ul>
            <li><b>Cotação em segundos.</b> Digitou a distância, o valor aparece. Sem calculadora.</li>
            <li><b>Mensagem pronta.</b> A cotação vai para o cliente pelo seu WhatsApp, com um toque.</li>
            <li><b>Pix na hora.</b> O QR Code aparece na tela quando você entrega o veículo.</li>
            <li><b>Nada fica esquecido.</b> O que ficou a receber aparece no topo da tela.</li>
          </ul>
          <p class="plano-do-publico">Plano Essencial, {brl(planos[0].precoMensal)} por mês. <a href="/cadastro/?plano=essencial">Testar grátis</a></p>
        </article>
        <article class="publico publico-loja">
          <h3>Para empresas com frota</h3>
          <p class="quem-e">Dois caminhões ou mais, motoristas e alguém atendendo os pedidos.</p>
          <ul>
            <li><b>Quem está livre?</b> O quadro mostra cada chamado e o motorista que está com ele.</li>
            <li><b>Cada um com seu acesso.</b> O atendente abre chamados sem ver o faturamento.</li>
            <li><b>Comissão somada.</b> Faturamento e comissão por motorista, sem planilha.</li>
            <li><b>Parceiros organizados.</b> Oficinas e seguradoras com o que cada uma ainda deve.</li>
          </ul>
          <p class="plano-do-publico">Plano Frota, {brl(planos[1].precoMensal)} por mês. <a href="/cadastro/?plano=equipe">Testar grátis</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="secao secao-escura" id="simulador">
    <div class="container sim-grade">
      <div>
        <h2>Faça uma cotação agora</h2>
        <p class="lead">Coloque a sua tabela e a distância. É a mesma conta que o Reboka faz em cada chamado.</p>
        <form class="sim" id="sim" onsubmit="return false">
          <label>Saída (R$)
            <input type="number" id="s-saida" value="150" min="0" step="10" inputmode="numeric" />
          </label>
          <label>Valor por km (R$)
            <input type="number" id="s-km-valor" value="4.5" min="0" step="0.5" inputmode="decimal" />
          </label>
          <label>Distância (km)
            <input type="number" id="s-km" value="18" min="0" step="1" inputmode="numeric" />
          </label>
          <label>Acréscimo noturno (%)
            <input type="number" id="s-noturno-pct" value="30" min="0" max="200" step="5" inputmode="numeric" />
          </label>
          <label class="sim-marcar"><input type="checkbox" id="s-noturno" /> É noite, domingo ou feriado</label>
          <label class="sim-marcar"><input type="checkbox" id="s-patins" /> Precisa de patins (+R$ 80)</label>
        </form>
      </div>
      <div class="sim-resultado" aria-live="polite">
        <p>Valor do chamado</p>
        <strong id="s-total" class="grande">R$ 231</strong>
        <p>Mensagem pronta para o cliente</p>
        <div class="sim-balao" id="s-msg"></div>
        <small>Os valores acima são um exemplo. Cada empresa cadastra a própria tabela de preço.</small>
      </div>
    </div>
  </section>

  <section class="secao secao-nevoa" id="como-funciona">
    <div class="container">
      <h2>Três toques entre o pedido e o pagamento</h2>
      <ol class="passos">
        {passos.map((p, i) => (
          <li>
            <span class="n">{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao" id="recursos">
    <div class="container">
      <h2>O que vem no Reboka</h2>
      <p class="lead">O dia a dia do guincho, bem feito. Sem módulo que ninguém abre.</p>
      <div class="recursos">
        {recursos.map((r) => (
          <div class:list={['recurso', { largo: r.largo }]}>
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </div>
        ))}
      </div>

      <div class="para-quem sem-foto">
        <div>
          <h3>Feito para</h3>
          <ul>
            <li>Guincheiros autônomos e empresas de reboque e socorro.</li>
            <li>Quem atende cliente particular, oficina e seguradora.</li>
            <li>Quem quer parar de perder chamado por demorar na cotação.</li>
          </ul>
        </div>
        <div>
          <h3>Não é para</h3>
          <ul>
            <li>Emitir nota fiscal ou conhecimento de transporte.</li>
            <li>Rastrear o caminhão por GPS.</li>
            <li>Receber chamados distribuídos por aplicativos ou seguradoras.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao-nevoa" id="planos">
    <div class="container">
      <h2>Planos</h2>
      <p class="lead">{TESTE_GRATIS_DIAS} dias grátis em qualquer plano. Sem fidelidade no mensal.</p>
      <div class="alternar" role="group" aria-label="Forma de cobrança">
        <button type="button" class="ativo" data-ciclo="mensal" aria-pressed="true">Mensal</button>
        <button type="button" data-ciclo="anual" aria-pressed="false">Anual, {DESCONTO_ANUAL * 100}% de desconto</button>
      </div>
      <div class="planos planos-dois">
        {planos.map((pl) => (
          <div class:list={['plano', { destaque: pl.destaque }]}>
            {pl.destaque && <span class="selo">Para frotas</span>}
            <h3>{pl.nome}</h3>
            <p class="pq">{pl.paraQuem}</p>
            <p class="preco">
              <span data-mensal={brl(pl.precoMensal)} data-anual={brl(pl.precoMensal * (1 - DESCONTO_ANUAL))}>{brl(pl.precoMensal)}</span>
              <small>por mês</small>
            </p>
            <p class="limites">{pl.limites}</p>
            <ul>{pl.itens.map((i) => <li>{i}</li>)}</ul>
            <a class={`btn ${pl.destaque ? 'btn-primario' : 'btn-secundario'}`} href={`/cadastro/?plano=${pl.id}`}>Testar grátis</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="secao" id="duvidas">
    <div class="container faq-grade">
      <h2>Dúvidas frequentes</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.p}</summary>
            <p>{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="rodo-secao">
    <div class="container">
      <div class="rodo-palco" id="rodo">
        <div class="rodo-conteudo">
          <h2>O próximo chamado já pode sair cotado.</h2>
          <p class="lead">Abra a demonstração, crie um chamado e veja o valor aparecer.</p>
          <a class="btn" href="/cadastro/">Testar {TESTE_GRATIS_DIAS} dias grátis</a>
          <p class="mini">Sem cartão de crédito.</p>
        </div>
        <div class="rodo-espuma" aria-hidden="true"><i class="pista"></i></div>
        <div class="rodo-ferramenta" aria-hidden="true">
          <svg class="carrinho" viewBox="0 0 160 62" width="170" height="66">
            <path d="M8,46 L8,35 Q8,29 16,27 L40,23 L58,9 Q62,6 68,6 L104,6 Q110,6 115,10 L132,25 L148,29 Q154,31 154,37 L154,46 Z" fill="#FFD23F" stroke="#fff" stroke-width="3" stroke-linejoin="round" />
            <path d="M63,12 L84,12 L84,24 L47,24 Z M90,12 L105,12 L120,24 L90,24 Z" fill="#fff" />
            <rect x="146" y="32" width="8" height="6" rx="2" fill="#FFD95C" />
            <circle cx="42" cy="46" r="11" fill="#14161A" stroke="#fff" stroke-width="3" /><circle cx="42" cy="46" r="4" fill="#A9AEB8" />
            <circle cx="122" cy="46" r="11" fill="#14161A" stroke="#fff" stroke-width="3" /><circle cx="122" cy="46" r="4" fill="#A9AEB8" />
          </svg>
          <span>Arraste o carro</span>
        </div>
      </div>
    </div>
    <div class="fecho-base" aria-hidden="true"></div>
  </section>

  <script>
    // Fecho "o caminho do guincho": a seção começa coberta pela pista e a pessoa arrasta o carro para revelar a chamada.
    // --x é a porcentagem já percorrida, da esquerda para a direita. Sem JavaScript, ou com movimento reduzido, não há pista.
    const rodo = document.querySelector<HTMLElement>('#rodo');
    if (rodo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let x = 12, arrastando = false, relogio = 0, quadroRodo = 0;
      const pinta = () => rodo.style.setProperty('--x', String(x));
      const terminar = () => { rodo.classList.add('limpo'); clearTimeout(relogio); cancelAnimationFrame(quadroRodo); };
      // Termina sozinho: ninguém pode ficar sem ver o botão por não ter arrastado.
      const sozinho = () => {
        const de = x, inicio = performance.now();
        const passo = (agora: number) => {
          const t = Math.min((agora - inicio) / 1500, 1);
          x = de + (100 - de) * (1 - Math.pow(1 - t, 3)); pinta();
          if (t < 1) quadroRodo = requestAnimationFrame(passo); else terminar();
        };
        quadroRodo = requestAnimationFrame(passo);
      };
      const agendar = (ms: number) => { clearTimeout(relogio); relogio = window.setTimeout(sozinho, ms); };
      const mover = (e: PointerEvent) => {
        const r = rodo.getBoundingClientRect();
        x = Math.max(x, Math.min(100, ((e.clientX - r.left) / r.width) * 100)); pinta();
        if (x >= 93) terminar();
      };
      rodo.classList.add('com-espuma'); pinta();
      rodo.addEventListener('pointerdown', (e) => {
        if (rodo.classList.contains('limpo')) return;
        arrastando = true; rodo.setPointerCapture(e.pointerId); clearTimeout(relogio); cancelAnimationFrame(quadroRodo); mover(e);
      });
      rodo.addEventListener('pointermove', (e) => { if (arrastando && !rodo.classList.contains('limpo')) mover(e); });
      const soltar = () => { if (!arrastando) return; arrastando = false; if (!rodo.classList.contains('limpo')) agendar(5000); };
      rodo.addEventListener('pointerup', soltar); rodo.addEventListener('pointercancel', soltar);
      // Quem navega pelo teclado chega ao botão sem arrastar: a pista sai na hora.
      rodo.addEventListener('focusin', terminar);
      new IntersectionObserver((e, o) => { if (e[0].isIntersecting) { agendar(3500); o.disconnect(); } }, { threshold: 0.5 }).observe(rodo);
    }

    // Simulador de cotação: a mesma conta do painel (saída + km, acréscimo noturno, adicionais).
    const n = (id: string) => Math.max(0, Number((document.getElementById(id) as HTMLInputElement).value) || 0);
    const marcado = (id: string) => (document.getElementById(id) as HTMLInputElement).checked;
    const real = (v: number) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
    function simular() {
      const base = n('s-saida') + n('s-km') * n('s-km-valor');
      const total = Math.round(base * (marcado('s-noturno') ? 1 + n('s-noturno-pct') / 100 : 1) + (marcado('s-patins') ? 80 : 0));
      document.getElementById('s-total')!.textContent = real(total);
      document.getElementById('s-msg')!.textContent = `Oi, Carlos! O guincho (${n('s-km')} km) fica em ${real(total)}. Posso mandar o caminhão agora?`;
    }
    document.getElementById('sim')!.addEventListener('input', simular);
    simular();

    // Mensal ou anual
    document.querySelectorAll<HTMLButtonElement>('.alternar button').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('.alternar button').forEach((x) => {
          x.classList.toggle('ativo', x === b);
          x.setAttribute('aria-pressed', String(x === b));
        });
        document.querySelectorAll<HTMLElement>('.preco span').forEach((s) => (s.textContent = s.dataset[b.dataset.ciclo!]!));
      }),
    );

  </script>
</Base>
<style>
  /* hero escura e compacta — fala muito com pouco */
  .hero { position: relative; background: linear-gradient(180deg, #0B0C0F 0%, #101216 42%, var(--grafite) 72%, #23262E 100%); color: #fff; padding-block: clamp(26px, 3.6vw, 52px) clamp(30px, 4vw, 60px); overflow: hidden; }
  /* Emenda (fade) entre a hero azul e a seção branca — azul royal descendo até o branco, sem traço */
  .emenda { height: 170px; background: linear-gradient(180deg, #23262E 0%, #6B7078 32%, #A9AEB8 64%, var(--nevoa) 88%, var(--papel) 100%); }
  /* Hero desktop: foto full-bleed na hero inteira, texto por cima à esquerda */
  .hero-grade { display: block; position: relative; z-index: 1; min-height: clamp(480px, 46vw, 640px); display: flex; flex-direction: column; justify-content: center; }
  .hero-texto { text-align: left; max-width: min(660px, 62%); }
  .hero-texto h1 { color: #fff; font-size: clamp(2.2rem, 4vw, 3.3rem); line-height: 1.08; letter-spacing: -0.02em; margin: 0; text-shadow: 0 2px 24px rgba(0,0,0,.45); }
  .hero-texto h1 .hl2 { white-space: nowrap; }
  .hero-texto h1 .realce { color: var(--farol); }
  .hero-texto .lead { font-size: clamp(1.05rem, 2.2vw, 1.22rem); max-width: 42ch; margin: 16px 0 0; color: #E9EBEE; text-shadow: 0 1px 14px rgba(0,0,0,.5); }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; justify-content: flex-start; }
  .hero-acoes .btn-primario { padding: 16px 32px; font-size: 1.04rem; }
  .hero .btn-secundario { background: transparent; color: #fff; border-color: rgba(255, 255, 255, .4); }
  .hero .btn-secundario:hover { border-color: #fff; background: rgba(255, 255, 255, .08); }
  .hero-prova { display: flex; align-items: center; justify-content: flex-start; gap: 10px; margin-top: 20px; color: #E4E6EB; font-size: .9rem; font-weight: 500; flex-wrap: wrap; }
  .hero-estrelas { color: #F5B301; letter-spacing: 2px; font-size: 1.02rem; }
  .hero-nota { margin-top: 14px; color: #A9AEB8; font-size: .85rem; text-align: left; }

  /* Destaques (3) em cartões sobre fundo escuro */
  .hero-bene { list-style: none; margin: clamp(28px, 4vw, 44px) auto 0; padding: 0; width: min(980px, 100% - 40px); display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .hero-bene li { display: flex; align-items: center; gap: 13px; text-align: left; font-size: .98rem; line-height: 1.32; color: #E4E6EB; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.12); border-radius: var(--raio-m); padding: 15px 16px; backdrop-filter: blur(6px); }
  .hero-bene b { color: #fff; font-weight: 700; }
  .bene-ic { flex-shrink: 0; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 0; background: var(--grad-primario); color: #fff; box-shadow: 0 8px 18px -8px rgba(255, 194, 26,.7); }
  .bene-ic svg { width: 21px; height: 21px; }

  /* Vitrine compacta — celular + QR sobrepostos (conceito NeuralFood) */
  .vitrine { position: relative; display: flex; justify-content: center; align-items: center; margin: clamp(22px, 3.4vw, 38px) auto 0; padding-bottom: 30px; perspective: 1500px; perspective-origin: 50% 45%; }
  .vitrine::before { content: ""; position: absolute; left: 50%; top: 52%; width: 66%; height: 82%; translate: -50% -50%; background: radial-gradient(ellipse at center, rgba(255, 194, 26,.42), rgba(255, 194, 26,0) 64%); filter: blur(38px); z-index: 0; pointer-events: none; }
  .disp { position: relative; display: flex; flex-direction: column; align-items: center; transform-style: preserve-3d; }
  .dev { position: relative; }
  .dev-tela { position: relative; overflow: hidden; background: #0B0F1A; }
  .dev-tela img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .dev-tela::after { content: ""; position: absolute; inset: 0; background: linear-gradient(118deg, rgba(255,255,255,.22) 0%, rgba(255,255,255,.05) 18%, rgba(255,255,255,0) 38%); mix-blend-mode: screen; pointer-events: none; }
  .dev::before { content: ""; position: absolute; left: 50%; bottom: -20px; width: 84%; height: 22px; translate: -50% 0; background: radial-gradient(ellipse at center, rgba(0,0,0,.45), rgba(0,0,0,0) 70%); filter: blur(7px); z-index: -1; }
  /* celular à frente (esquerda), QR atrás (direita) */
  .disp:nth-child(1) { z-index: 3; transform: translateY(-6px) rotateY(-7deg); margin-right: -34px; }
  .disp:nth-child(2) { z-index: 1; transform: translateY(20px) rotateY(-13deg); }
  /* onda "aponte a câmera" entre celular e QR */
  .onda { position: absolute; left: -14px; top: 42%; width: 70px; height: 70px; translate: -50% -50%; z-index: 2; pointer-events: none; }
  .onda i { position: absolute; inset: 0; margin: auto; width: 100%; height: 100%; border: 2px solid var(--marca); border-radius: 50%; opacity: 0; animation: pulso 2.4s ease-out infinite; }
  .onda i:nth-child(2) { animation-delay: .8s; }
  .onda i:nth-child(3) { animation-delay: 1.6s; }
  @keyframes pulso { 0% { transform: scale(.4); opacity: .7; } 100% { transform: scale(1.1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .onda i { animation: none; opacity: .3; } }
  /* celular (menor) */
  .dev-phone { width: clamp(128px, 17vw, 172px); }
  .dev-phone .dev-tela { aspect-ratio: 9 / 19; border: 7px solid #0B0F1A; border-radius: 28px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.1), 0 30px 48px -22px rgba(22, 24, 29,.55); }
  .dev-phone .ilha { position: absolute; top: 8px; left: 50%; translate: -50% 0; width: 34%; height: 11px; background: #0B0C0F; border-radius: 99px; z-index: 2; }
  .dev-phone .dev-home { position: absolute; bottom: 6px; left: 50%; translate: -50% 0; width: 34%; height: 4px; background: rgba(255,255,255,.85); border-radius: 99px; z-index: 2; }
  /* qr em cartão de acrílico branco (menor) */
  .dev-qr { width: clamp(138px, 18vw, 182px); }
  .dev-qr .dev-tela { aspect-ratio: 3 / 4.2; border-radius: 16px; padding: 16px 14px 22px; background: #fff; border: 1px solid var(--borda); box-shadow: inset 0 1px 0 rgba(255,255,255,.8), 0 24px 42px -22px rgba(22, 24, 29,.4); display: flex; align-items: center; justify-content: center; }
  .dev-qr .dev-tela img { width: 100%; height: auto; object-fit: contain; border-radius: 8px; background: #fff; }
  .dev-qr .dev-pe { display: block; width: 46%; height: 10px; margin: 0 auto; background: linear-gradient(#F1F2F4, #E9EBEE); border: 1px solid var(--borda); border-top: 0; border-radius: 0 0 8px 8px; }
  /* desktop: foto cobrindo a hero inteira (full-bleed), texto por cima */
  .hero-foto { position: absolute; inset: 0; margin: 0; max-width: none; width: 100%; height: 100%; z-index: 0; }
  .hero-foto img { display: block; width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; object-position: 72% center; border: 0; border-radius: 0; box-shadow: none; -webkit-mask-image: none; mask-image: none; }
  /* scrim escuro à esquerda (legibilidade) + fade na base pra emendar no azul */
  .hero-foto::after { content: ""; position: absolute; inset: 0; pointer-events: none; background:
    linear-gradient(90deg, rgba(11, 14, 8,.95) 0%, rgba(11, 14, 8,.82) 34%, rgba(11, 14, 8,.35) 66%, rgba(22, 24, 29,.45) 100%),
    linear-gradient(180deg, rgba(11, 14, 8,.4) 0%, rgba(11, 14, 8,0) 22%, rgba(11, 14, 8,0) 72%, #23262E 100%); }
  /* A mão recortada, sem fundo. A sombra fica no invólucro: se ficasse na imagem, a máscara que some com o punho cortaria a sombra num retângulo. */
  .hero-mao { position: relative; filter: drop-shadow(0 22px 26px rgba(22, 24, 29, .28)); }
  .hero-mao img { display: block; width: 100%; height: auto; -webkit-mask-image: linear-gradient(#000 86%, transparent); mask-image: linear-gradient(#000 86%, transparent); }
  .hero-foto figcaption { color: var(--cinza); font-size: .8rem; text-align: center; margin-top: 20px; }
  /* Anéis que se abrem atrás da mão: o mesmo anel de ciclo do painel, em escala. */
  /* Carrossel horizontal (rola/arrasta) no lugar da imagem */
  .hero-carrossel { position: relative; }
  .hero-trilho { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .hero-trilho::-webkit-scrollbar { display: none; }
  .hero-slide { position: relative; flex: 0 0 100%; scroll-snap-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 4px 0 2px; }
  .hero-slide img { display: block; width: auto; height: 470px; max-height: 60vh; border-radius: 0; border: 5px solid #0B0F1A; box-shadow: 0 34px 60px -24px rgba(0,0,0,.65); background: #0B0F1A; }
  .hero-tag { order: -1; align-self: center; background: rgba(255,255,255,.1); color: #fff; font: 600 .78rem var(--fonte-texto); padding: 5px 14px; border-radius: 99px; border: 1px solid rgba(255,255,255,.18); }
  .hero-dots { display: flex; gap: 8px; justify-content: center; margin-top: 14px; }
  .hero-dots button { width: 8px; height: 8px; border-radius: 50%; border: 0; background: rgba(255,255,255,.3); cursor: pointer; padding: 0; transition: width .2s, background .2s; }
  .hero-dots button[aria-current="true"] { width: 22px; border-radius: 99px; background: #fff; }
  .hero-foto figcaption { color: #A9AEB8; font-size: .8rem; text-align: center; margin-top: 20px; }
  /* Ondas: círculos que se abrem atrás da mão, como uma gota caindo na água. */
  .hero-ondas { position: absolute; inset: 0; }
  .hero-ondas i { position: absolute; left: 50%; top: 54%; aspect-ratio: 1; border-radius: 50%; border: 2px solid var(--marca-clara); translate: -50% -50%; animation: abrir 1.1s cubic-bezier(.2, .8, .3, 1) both; }
  .hero-ondas i:nth-child(1) { width: 78%; background: var(--nevoa); border-color: var(--farol); }
  .hero-ondas i:nth-child(2) { width: 108%; opacity: .6; animation-delay: .18s; }
  .hero-ondas i:nth-child(3) { width: 138%; opacity: .35; animation-delay: .36s; }
  .hero-ondas i:nth-child(4) { width: 168%; opacity: .18; animation-delay: .54s; }
  .flutua { position: absolute; box-shadow: var(--sombra); animation: chegar .6s cubic-bezier(.2, .9, .3, 1) both; }
  .flutua.f1 { left: -30%; top: 62%; font-size: .9rem; animation-delay: 1s; }
  .flutua.f2 { right: -26%; bottom: 6%; max-width: 240px; background: #fff; border-radius: 18px 18px 6px 18px; padding: 12px 16px; font-size: .88rem; line-height: 1.4; animation-delay: 1.35s; }
  .flutua.f2 b { display: block; font-size: .76rem; color: var(--marca-escura); font-weight: 600; }
  @keyframes abrir { from { scale: .55; opacity: 0; } }
  @keyframes chegar { from { opacity: 0; translate: 0 14px; } }

  /* ciclo */
  .ciclo-grade { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .procs { border: 0; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .procs legend { font-weight: 600; margin-bottom: 10px; padding: 0; }
  .proc { position: relative; border-radius: var(--raio-m); overflow: hidden; cursor: pointer; aspect-ratio: 4 / 5; display: block; outline: 3px solid transparent; outline-offset: 2px; transition: outline-color .15s; }
  .proc input { position: absolute; opacity: 0; inset: 0; }
  .proc img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.75); transition: filter .2s, scale .3s; }
  .proc span { position: absolute; inset: auto 0 0 0; padding: 26px 10px 9px; color: #fff; font-size: .78rem; line-height: 1.25; background: linear-gradient(transparent, rgba(24, 33, 14, .82)); }
  .proc span b { display: block; font: 600 .84rem var(--fonte-titulo); letter-spacing: -0.02em; }
  .proc:hover img { scale: 1.04; }
  .proc:has(input:checked) { outline-color: var(--marca); }
  .proc:has(input:checked) img { filter: none; }
  .proc:has(input:focus-visible) { outline-color: var(--grafite); }
  .controles { display: grid; gap: 10px; margin-top: 20px; }
  .controles label { font-weight: 600; margin-top: 10px; }
  select, input[type="number"] {
    font: 500 1rem var(--fonte-texto); color: var(--tinta); padding: 13px 14px; border-radius: var(--raio-p);
    border: 1.5px solid var(--borda); background: #fff; width: 100%;
  }
  input[type="range"] { width: 100%; accent-color: var(--marca); height: 28px; }
  .controles + .meta { margin-top: 14px; }
  .demo { display: grid; justify-items: center; gap: 20px; min-height: 470px; align-content: start; }
  .anelao { width: min(300px, 78vw); }
  .anelao .num { font: 600 44px var(--fonte-titulo); fill: var(--tinta); letter-spacing: -0.03em; }
  .anelao .sub { font: 500 16px var(--fonte-texto); fill: var(--cinza); }
  #arco { transition: stroke-dasharray .25s ease, stroke .25s; }
  #ponto { transition: opacity .25s; }
  .demo .chip { font-size: 1rem; padding: 9px 18px; }
  .balao { background: var(--nevoa); border-radius: 20px 20px 20px 6px; padding: 16px 20px; max-width: 400px; }
  .balao .de { font-size: .82rem; font-weight: 600; color: var(--marca-escura); }
  .balao[hidden] { display: none; }

  /* passos */
  .passos { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .passos li { background: #fff; border-radius: var(--raio-g); padding: 30px; }
  .passos .n { display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--grafite); color: #fff; font: 600 1.1rem var(--fonte-titulo); margin-bottom: 18px; }
  .passos h3 { margin-bottom: 8px; }
  .passos p { color: #3D4249; }

  /* recursos */
  .recursos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 44px; border-top: 1.5px solid var(--borda); }
  .recurso { padding: 28px 28px 28px 0; border-bottom: 1.5px solid var(--borda); }
  .recurso.largo { grid-column: span 2; }
  .recurso h3 { margin-bottom: 8px; }
  .recurso p { color: #3D4249; max-width: 46ch; }
  .recurso.largo h3 { font-size: 1.6rem; }
  .foto { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: var(--raio-g); }
  .para-quem { display: grid; grid-template-columns: 1.15fr 1fr; gap: 28px; margin-top: 56px; }
  .para-quem .foto { grid-row: span 2; min-height: 320px; }
  .para-quem > div { border-radius: var(--raio-g); padding: 30px; background: var(--nevoa); }
  .para-quem > div:last-child { background: transparent; border: 1.5px solid var(--borda); }
  .para-quem ul { margin: 14px 0 0; padding-left: 20px; display: grid; gap: 8px; color: #3D4249; }

  /* simulador */
  .sim-grade { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .sim { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 32px; }
  .sim label { display: grid; gap: 8px; font-weight: 500; color: #E4E6EB; font-size: .95rem; }
  .sim input { background: var(--grafite-2); border-color: #3F5226; color: #fff; font-size: 1.15rem; font-weight: 600; }
  .sim-resultado { background: var(--grafite-2); border-radius: var(--raio-g); padding: 36px; display: grid; gap: 4px; }
  .sim-resultado p { color: #E4E6EB; }
  .sim-resultado strong { font: 600 2.2rem var(--fonte-titulo); letter-spacing: -0.03em; margin-bottom: 18px; }
  .sim-resultado strong.grande { font-size: clamp(2.6rem, 5vw, 3.6rem); color: var(--farol); }
  .sim-resultado small { color: #A9AEB8; font-size: .88rem; line-height: 1.45; }

  /* planos */
  .alternar { display: inline-flex; background: var(--nevoa); border-radius: 0; padding: 5px; margin-top: 28px; }
  .alternar button { font: 600 .98rem var(--fonte-texto); border: 0; background: transparent; color: var(--cinza); padding: 10px 18px; border-radius: 0; cursor: pointer; }
  .alternar button.ativo { background: #fff; color: var(--grafite); box-shadow: 0 2px 8px -3px rgba(22, 24, 29,.3); }
  .planos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; max-width: 1080px; }
  .plano { border: 1.5px solid var(--borda); border-radius: var(--raio-g); padding: 34px; display: flex; flex-direction: column; background: #fff; position: relative; }
  .plano.destaque { border-color: var(--marca); box-shadow: var(--sombra); }
  .selo { position: absolute; top: -14px; left: 30px; background: var(--grafite); color: #fff; font-size: .82rem; font-weight: 600; padding: 5px 12px; border-radius: 99px; }
  .pq { color: var(--cinza); margin-top: 6px; }
  .preco { margin-top: 22px; display: flex; align-items: baseline; gap: 8px; }
  .preco span { font: 600 3rem var(--fonte-titulo); letter-spacing: -0.04em; }
  .preco small { color: var(--cinza); font-size: 1rem; }
  .limites { font-weight: 600; margin-top: 4px; }
  .plano ul { list-style: none; padding: 0; margin: 22px 0 28px; display: grid; gap: 10px; flex: 1; }
  .plano li { padding-left: 28px; position: relative; }
  .plano li::before { content: ""; position: absolute; left: 0; top: .38em; width: 14px; height: 14px; border-radius: 50%; border: 4px solid var(--marca); }
  .centro { margin-top: 28px; }

  /* faq */
  .faq-grade { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .faq details { background: #fff; border-radius: var(--raio-m); padding: 4px 24px; margin-bottom: 12px; }
  .faq summary { font-weight: 600; font-size: 1.08rem; padding: 18px 28px 18px 0; cursor: pointer; list-style: none; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; position: absolute; right: 0; top: 12px; font: 500 1.6rem var(--fonte-titulo); color: var(--marca-escura); }
  .faq details[open] summary::after { content: "−"; }
  .faq details p { padding-bottom: 20px; color: #3D4249; max-width: 62ch; }

  .oque h2 { max-width: 22ch; }
  .trio { display: grid; grid-template-columns: 1fr 1fr 1.25fr; gap: 14px; margin: clamp(28px, 4vw, 44px) 0; }
  .trio > div { border: 1.5px solid var(--borda); border-radius: var(--raio-m); padding: 22px 24px; background: #fff; }
  .trio h3 { font-size: 1rem; font-family: var(--fonte-texto); font-weight: 600; letter-spacing: 0; color: var(--cinza); }
  .trio p { font: 500 clamp(1.15rem, 2vw, 1.45rem)/1.3 var(--fonte-titulo); letter-spacing: -0.02em; margin-top: 8px; }
  .trio b { font-weight: 600; }
  .trio-destaque { background: var(--grafite) !important; border-color: var(--grafite) !important; color: #fff; }
  .trio-destaque h3 { color: var(--farol); }
  .trio-destaque b { color: var(--farol); }
  .publicos { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .publico { background: var(--nevoa); border-radius: var(--raio-g); padding: clamp(24px, 3vw, 38px); display: grid; align-content: start; gap: 14px; }
  .publico-loja { background: #fff; border: 1.5px solid var(--borda); }
  .publico h3 { font-size: clamp(1.4rem, 2.4vw, 1.8rem); }
  .publico .quem-e { color: var(--cinza); }
  .publico ul { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 14px; }
  .publico li { padding-left: 22px; position: relative; color: #3D4249; }
  .publico li::before { content: ""; position: absolute; left: 0; top: .5em; width: 10px; height: 10px; border-radius: 50%; border: 3px solid var(--marca); }
  .publico li b { color: var(--tinta); font-weight: 600; }
  .plano-do-publico { margin-top: 8px; padding-top: 16px; border-top: 1.5px solid var(--borda); font-weight: 500; }
  .plano-do-publico a { color: var(--marca-escura); font-weight: 600; margin-left: 6px; }
  @media (max-width: 820px) {
    .trio, .publicos { grid-template-columns: 1fr; }
    /* Hero mobile: centralizada, fonte menor, foto integrada (sem bordas) */
    .hero-grade { display: flex; flex-direction: column; align-items: center; text-align: center; gap: clamp(26px, 6vw, 40px); min-height: 0; justify-content: flex-start; }
    .hero-texto { text-align: center; max-width: 620px; }
    .hero-texto h1 { font-size: clamp(2.1rem, 7.6vw, 2.9rem); line-height: 1.08; max-width: 16ch; margin: 0 auto; text-shadow: none; }
    .hero-texto h1 .hl2 { white-space: normal; }
    .hero-texto .lead { font-size: clamp(1.05rem, 3.8vw, 1.22rem); margin: 16px auto 0; }
    .hero-acoes { justify-content: center; }
    .hero-prova { justify-content: center; }
    .hero-nota { text-align: center; }
    /* foto full-bleed, ocupando toda a largura da seção */
    .hero-foto { position: static; inset: auto; width: 100vw; max-width: 100vw; height: auto; align-self: start; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); transform: none; }
    .hero-foto::after { display: none; }
    .hero-foto img { height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 55% center; border: 0; border-radius: 0; box-shadow: none;
      -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0) 0%, #000 13%, #000 87%, rgba(0,0,0,0) 100%);
      mask-image: linear-gradient(180deg, rgba(0,0,0,0) 0%, #000 13%, #000 87%, rgba(0,0,0,0) 100%);
      -webkit-mask-composite: source-over; mask-composite: add; }
  }
  /* Fecho "o caminho da oficina": a pista cobre a chamada e o carro, arrastado, revela. */
  .rodo-secao { padding-top: clamp(56px, 8vw, 104px); }
  .rodo-palco { --x: 100; position: relative; overflow: hidden; background: var(--grafite); color: #fff; border-radius: var(--raio-g); min-height: clamp(400px, 44vw, 500px); display: grid; place-items: center; padding: 56px 28px; touch-action: pan-y; margin-bottom: clamp(48px, 7vw, 88px); }
  .rodo-conteudo { text-align: center; display: grid; justify-items: center; max-width: 640px; }
  .rodo-conteudo h2 { color: #fff; font-size: clamp(1.9rem, 4.4vw, 3.1rem); max-width: 16ch; }
  .rodo-conteudo .lead { color: var(--farol); margin: 16px 0 28px; max-width: 46ch; }
  .rodo-conteudo .btn { background: var(--farol); color: var(--grafite); padding: 16px 34px; border-radius: 0; }
  .rodo-conteudo .btn:hover { background: #fff; }
  .rodo-conteudo .mini { margin-top: 14px; font-size: .88rem; color: #A9AEB8; }
  .rodo-espuma, .rodo-ferramenta { display: none; }
  .com-espuma { cursor: ew-resize; user-select: none; -webkit-user-select: none; }
  .com-espuma .rodo-espuma { display: block; position: absolute; inset: 0; background: #E9EBEE; clip-path: inset(0 0 0 calc(var(--x) * 1%)); }
  /* Faixa tracejada da pista, na altura das rodas do carro. */
  .rodo-espuma .pista { position: absolute; left: 0; right: 0; top: calc(50% + 27px); height: 8px; border-radius: 0; background: repeating-linear-gradient(90deg, #C5CAD1 0 54px, transparent 54px 96px); }
  .com-espuma .rodo-ferramenta { display: block; position: absolute; top: 0; bottom: 0; left: calc(var(--x) * 1%); width: 0; pointer-events: none; }
  .rodo-ferramenta .carrinho { max-width: none; position: absolute; left: -60px; top: calc(50% - 32px); filter: drop-shadow(0 10px 12px rgba(22, 24, 29, .3)); }
  .rodo-ferramenta span { position: absolute; left: 128px; top: calc(50% - 20px); white-space: nowrap; background: #fff; color: var(--grafite); padding: 8px 14px; border-radius: 99px; font-weight: 600; font-size: .88rem; box-shadow: var(--sombra); animation: chamar 1.6s ease-in-out infinite; }
  @keyframes chamar { 50% { translate: 8px 0; } }
  .rodo-palco.limpo { cursor: auto; }
  .rodo-palco.limpo .rodo-espuma, .rodo-palco.limpo .rodo-ferramenta { display: none; }
