---
import Logo from './Logo.astro';
import { empresa } from '../data/site';
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="container grade">
    <div class="sobre">
      <Logo cor="#fff" realce="var(--marca-clara)" />
      <p>O sistema do guincheiro: chamados, cotação por km e cobrança em um lugar só.</p>
    </div>
    <nav aria-label="Produto">
      <h4>Produto</h4>
      <a href="/#como-funciona">Como funciona</a>
      <a href="/#recursos">Recursos</a>
      <a href="/#planos">Planos</a>
      <a href="/cadastro/">Testar grátis</a>
    </nav>
    <nav aria-label="Conteúdo">
      <h4>Conteúdo</h4>
      <a href="/ajuda/">Central de ajuda</a>
      <a href={`mailto:${empresa.email}`}>Falar com a gente</a>
    </nav>
    <nav aria-label="Legal">
      <h4>Legal</h4>
      <a href="/termos/">Termos de uso</a>
      <a href="/privacidade/">Política de privacidade</a>
    </nav>
  </div>
  <div class="container legal">
    <p>© {ano} {empresa.produto}. Um produto da {empresa.razaoSocial}, CNPJ {empresa.cnpj}.</p>
    <p>{empresa.endereco}</p>
  </div>
</footer>
<style>
  .rodape { background: var(--grafite); color: #fff; padding: 40px 0 32px; }
  .grade { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; }
  .sobre p { color: #E4E6EB; margin-top: 14px; max-width: 30ch; }
  h4 { font-size: 1rem; margin-bottom: 14px; letter-spacing: -0.01em; }
  nav a { display: block; color: #E4E6EB; text-decoration: none; padding: 5px 0; }
  nav a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .legal { margin-top: 48px; padding-top: 24px; border-top: 1.5px solid var(--grafite-2); color: #A9AEB8; font-size: .9rem; display: grid; gap: 4px; }
  @media (max-width: 800px) { .grade { grid-template-columns: 1fr 1fr; } .sobre { grid-column: 1 / -1; } }
</style>
