---
import Logo from './Logo.astro';
interface Props { escuro?: boolean }
const { escuro = false } = Astro.props;
const links = [
  { href: '/#o-que-e', texto: 'O que é' },
  { href: '/#simulador', texto: 'Simular cotação' },
  { href: '/#como-funciona', texto: 'Como funciona' },
  { href: '/#recursos', texto: 'Recursos' },
  { href: '/#planos', texto: 'Planos' },
  { href: '/ajuda/', texto: 'Ajuda' },
];
---
<header class:list={['topo', { escuro }]}>
  <div class="container barra">
    <a href="/" aria-label="Reboka, página inicial" class="marca">
      <span class="logo-claro"><Logo cor="#fff" realce="var(--marca-clara)" /></span>
      <span class="logo-escuro"><Logo /></span>
    </a>
    <nav aria-label="Principal" class="links">
      {links.map((l) => <a href={l.href}>{l.texto}</a>)}
    </nav>
    <div class="acoes">
      <a href="/entrar/" class="entrar">Entrar</a>
      <a href="/cadastro/" class="btn btn-primario">Testar grátis</a>
    </div>
    <details class="menu">
      <summary aria-label="Abrir menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="gaveta">
        <div class="gaveta-topo">
          <Logo />
          <button type="button" class="gaveta-fechar" aria-label="Fechar menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
        </div>
        <nav class="gaveta-links">
          {links.map((l) => <a href={l.href}>{l.texto}</a>)}
        </nav>
        <div class="gaveta-rodape">
          <a href="/entrar/" class="gaveta-entrar">Entrar</a>
          <a href="/cadastro/" class="btn btn-primario gaveta-cta">Testar grátis</a>
        </div>
      </div>
    </details>
  </div>
</header>
<style>
  /* Cabeçalho de barra inteira (sem pílula): transparente sobre a hero escura e vira branco sólido ao rolar. */
  .topo { position: sticky; top: 0; z-index: 20; padding: 12px 0; background: #fff; border-bottom: 1px solid var(--borda); transition: background .25s ease, border-color .25s ease, box-shadow .25s ease; }
  /* Páginas com hero escura: começa transparente sobre o gradiente preto/azul. */
  .topo.escuro { background: transparent; border-bottom-color: transparent; }
  /* Ao rolar para baixo, abre o cabeçalho branco. */
  .topo.escuro.rolou { background: rgba(255, 255, 255, .97); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom-color: var(--borda); box-shadow: 0 10px 30px -24px rgba(22, 24, 29, .5); }
  .barra { display: flex; align-items: center; gap: 28px; min-height: 60px; padding: 0 4px; }
  .marca { text-decoration: none; display: inline-flex; align-items: center; }
  /* Troca de logo claro/escuro conforme o estado do cabeçalho. */
  .marca .logo-claro, .marca .logo-escuro { display: none; }
  .topo:not(.escuro) .marca .logo-escuro { display: inline-flex; }
  .topo.escuro .marca .logo-claro { display: inline-flex; }
  .topo.escuro.rolou .marca .logo-claro { display: none; }
  .topo.escuro.rolou .marca .logo-escuro { display: inline-flex; }
  .links { display: flex; gap: 26px; margin-left: 18px; flex: 1; }
  .links a, .entrar { text-decoration: none; font-weight: 500; font-size: 1rem; color: var(--tinta); opacity: .9; transition: color .25s ease; }
  .escuro .links a, .escuro .entrar { color: #fff; }
  .escuro.rolou .links a, .escuro.rolou .entrar { color: var(--tinta); }
  .links a:hover, .entrar:hover { opacity: 1; text-decoration: underline; text-underline-offset: 5px; }
  .acoes { display: flex; align-items: center; gap: 20px; margin-top: 0; flex-wrap: nowrap; }
  .acoes .btn { padding: 11px 20px; white-space: nowrap; border-radius: 0; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 42px; height: 42px; color: var(--grafite); border: 1.5px solid var(--borda); border-radius: 50%; }
  .escuro .menu summary { color: #fff; border-color: rgba(255,255,255,.3); }
  .escuro.rolou .menu summary { color: var(--grafite); border-color: var(--borda); }
  .menu summary::-webkit-details-marker { display: none; }
  /* Menu mobile: painel de página inteira deslizando da direita */
  .gaveta { position: fixed; inset: 0; z-index: 60; width: 100%; height: 100dvh; background: #fff; color: var(--tinta); padding: 18px clamp(20px, 6vw, 32px) calc(28px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; animation: gaveta-entra .28s cubic-bezier(.22, .61, .36, 1); }
  @keyframes gaveta-entra { from { transform: translateX(100%); } to { transform: translateX(0); } }
  .gaveta-topo { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20px; border-bottom: 1.5px solid var(--nevoa); }
  .gaveta-fechar { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--borda); background: #fff; color: var(--grafite); cursor: pointer; }
  .gaveta-links { display: flex; flex-direction: column; gap: 2px; margin-top: 18px; flex: 1; }
  .gaveta-links a { padding: 16px 6px; text-decoration: none; font-weight: 600; font-size: 1.25rem; color: var(--tinta); border-bottom: 1.5px solid var(--nevoa); }
  .gaveta-links a:active { color: var(--marca); }
  .gaveta-rodape { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding-top: 18px; }
  .gaveta-entrar { text-align: center; text-decoration: none; font-weight: 600; color: var(--grafite); padding: 14px; border: 1.5px solid var(--borda); border-radius: var(--raio-p); }
  .gaveta .gaveta-cta { text-align: center; justify-content: center; padding: 16px; font-size: 1.05rem; }
  body:has(.menu[open]) { overflow: hidden; }
  @media (max-width: 900px) {
    .links, .acoes { display: none; }
    .topo { padding: 10px 0; }
    .barra { justify-content: space-between; gap: 10px; min-height: 50px; padding: 0 6px; }
    .marca { zoom: .8; flex-shrink: 0; }
    .menu summary { width: 38px; height: 38px; }
    .menu { display: block; margin-left: auto; }
  }
  @media (max-width: 400px) {
    .barra { padding: 0 6px; min-height: 46px; }
    .marca { zoom: .72; }
    .menu summary { width: 36px; height: 36px; }
  }
</style>
<script>
  // Cabeçalho transparente sobre a hero escura; vira branco ao rolar para baixo.
  const topo = document.querySelector('.topo.escuro');
  if (topo) {
    const aoRolar = () => topo.classList.toggle('rolou', window.scrollY > 24);
    aoRolar();
    window.addEventListener('scroll', aoRolar, { passive: true });
  }

  // Menu mobile de página inteira: fechar pelo X, ao tocar num link ou com Esc.
  const menu = document.querySelector('.menu');
  if (menu) {
    const fechar = () => menu.removeAttribute('open');
    menu.querySelector('.gaveta-fechar')?.addEventListener('click', fechar);
    menu.querySelectorAll('.gaveta a').forEach((a) => a.addEventListener('click', fechar));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fechar(); });
  }
</script>
